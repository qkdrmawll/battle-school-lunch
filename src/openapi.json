{
  "openapi": "3.1.0",
  "info": {
    "title": "급식 배틀 API",
    "version": "1.0.0",
    "description": "급식 배틀 프론트엔드와 백엔드 사이의 공개 계약"
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "서비스 정상",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": { "type": "string", "const": "ok" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/schools": {
      "get": {
        "operationId": "searchSchools",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "학교 검색 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SchoolsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "502": { "$ref": "#/components/responses/UpstreamError" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/api/schools/{schoolCode}/meals": {
      "get": {
        "operationId": "getSchoolMeals",
        "parameters": [
          {
            "name": "schoolCode",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          },
          {
            "name": "educationOfficeCode",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": {
            "description": "급식 조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MealsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": {
            "description": "학교를 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "502": { "$ref": "#/components/responses/UpstreamError" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "School": {
        "type": "object",
        "required": ["educationOfficeCode", "schoolCode", "name", "region", "schoolType"],
        "properties": {
          "educationOfficeCode": { "type": "string" },
          "schoolCode": { "type": "string" },
          "name": { "type": "string" },
          "region": { "type": "string" },
          "schoolType": { "type": "string" }
        }
      },
      "SchoolsResponse": {
        "type": "object",
        "required": ["schools"],
        "properties": {
          "schools": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/School" }
          }
        }
      },
      "Meal": {
        "type": "object",
        "required": ["date", "mealType", "menu", "calories", "nutrition", "origin", "headcount"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "mealType": { "type": "string", "const": "중식" },
          "menu": { "type": "array", "items": { "type": "string" } },
          "calories": { "type": ["string", "null"] },
          "nutrition": { "type": ["string", "null"] },
          "origin": { "type": ["string", "null"] },
          "headcount": { "type": ["integer", "null"] }
        }
      },
      "MealsResponse": {
        "type": "object",
        "required": ["school", "from", "to", "meals"],
        "properties": {
          "school": {
            "type": "object",
            "required": ["educationOfficeCode", "schoolCode", "name"],
            "properties": {
              "educationOfficeCode": { "type": "string" },
              "schoolCode": { "type": "string" },
              "name": { "type": "string" }
            }
          },
          "from": { "type": "string", "format": "date" },
          "to": { "type": "string", "format": "date" },
          "meals": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Meal" }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "$ref": "#/components/schemas/Error" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "잘못된 입력",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "ValidationError": {
        "description": "계약 검증 실패",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "UpstreamError": {
        "description": "NEIS 오류 또는 잘못된 응답",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unavailable": {
        "description": "NEIS 연결 실패 또는 타임아웃",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    }
  }
}
